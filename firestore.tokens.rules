rules_version = '2';

// The database tilo-tokens holds connector token records (ADR-0032, SEC-02). Only tilo-connectors reaches it, through IAM,
// which bypasses these rules. No browser or phone client reads or writes anything here, now or later. One text, read by
// firebase.json and by Terraform (the ruleset and the release cloud.firestore/tilo-tokens).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
