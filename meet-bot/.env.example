# Copy to .env (gitignored). There is deliberately NO password variable: sign in once by hand via `login`.
# There is also no model, vendor or API key here (FR-MTG-11): models, speech and voice are Tilo config (config/), and the
# live switch and Google credentials are the user's own environment, never this file.
BOT_GOOGLE_EMAIL=tiloagent@gmail.com
# Name shown in Meet for the bot; its own name is ignored in captions. Optional (auto-detected if possible).
BOT_DISPLAY_NAME=

# Seconds to wait for the first word of an answer from the model before retrying once. A throttled project can take
# 0.7 s to 15 s per call, so this is generous; lower it when the quota is healthy.
FAST_FIRST_TOKEN_SECONDS=6

# Microphone: open = unmute once when the meeting starts for the bot and keep it on (it carries only synthesised speech,
# silence otherwise; re-checked every 15 s), so no answer waits for an unmute. conversation = unmute per answer.
MIC_POLICY=open

# Direct answers (questions put to the assistant) use a fast role on one long-lived client.
# FAST_THINKING: off | minimal | low | medium | high (which model answers is the role's profile in config/models.yaml).
FAST_THINKING=off

# Brain
BRAIN_INTERVAL_SECONDS=20
# Answering questions asked in the meeting: minimum seconds between replies, and the cap per meeting
DIRECT_REPLY_GAP_SECONDS=6
MAX_DIRECT_REPLIES=40
# questions = answer any question the meeting info can answer; addressed = only when the assistant is addressed
ANSWER_MODE=questions
RECORD_AUDIO=0
TRANSCRIPT_WINDOW_MINUTES=5
MEETING_MINUTES=
AGENDA_PATH=agenda.md

# Joining and leaving
JOIN_TIMEOUT_SECONDS=90
ASK_TO_JOIN_TIMEOUT_SECONDS=300
ALONE_GRACE_SECONDS=60
EMPTY_TIMEOUT_SECONDS=900
UNREADABLE_LEAVE_SECONDS=300
MAX_MEETING_MINUTES=120

# Laptop limits for the container
BOT_CPUS=2
BOT_MEM_LIMIT=3g

# Debugging: 1 = save raw caption DOM snapshots to debug/caption_snapshots/ (useful for parser fixtures)
SAVE_CAPTION_SNAPSHOTS=0
