!/packages/providers/
/packages/providers/*
!/packages/providers/src/
!/packages/redact/
/packages/redact/*
!/packages/redact/src/
!/services/
/services/*
!/services/connectors/
/services/connectors/*
!/services/connectors/src/
/services/connectors/src/*
!/services/connectors/src/tilo_connectors/
/services/connectors/src/tilo_connectors/*
!/services/connectors/src/tilo_connectors/host_auth.py
!/config/
/config/*
!/config/models*.yaml
!/config/prices*.yaml
!/config/speech*.yaml
!/config/voice*.yaml
!/config/meeting*.yaml
