# Copy to .env and fill in real values locally. Never commit .env.
# Tilo never stores real secrets in the repo (CLAUDE.md hard rule).

# Set to 1 only by the user to allow paid model calls (EFF-01). CI and dev default to 0.
LIVE=0

GOOGLE_CLOUD_PROJECT=tilo-dev
REGION=asia-southeast1

# Placeholders only — real values come from Secret Manager / local secret store.
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=
