# Copy to .env and fill in real values locally. Never commit .env.
# Tilo never stores real secrets in the repo (CLAUDE.md hard rule).

# Set to 1 only by the user to allow paid model calls (EFF-01). CI and dev default to 0.
LIVE=0

GOOGLE_CLOUD_PROJECT=tilo-dev
REGION=asia-southeast1

# Placeholders only — real values come from Secret Manager / local secret store.
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_EMULATOR_HOST=

# Set to 1 alongside LIVE=1 to record new fixtures/model-recordings/ entries (EFF-01);
# unset (the default) replays existing recordings.
TILO_RECORD=0

# config/models.yaml unless this names another file, e.g. config/models.nim.yaml to route
# roles to NVIDIA NIM for live tests without editing code (PL-02, ADR-0003).
TILO_MODELS_FILE=

# NVIDIA NIM API key (https://integrate.api.nvidia.com/v1), used only by
# config/models.nim.yaml's openai_compat profiles under LIVE=1. Never a real value here.
NVIDIA_API_KEY=
