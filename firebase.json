{
  "firestore": [
    { "database": "(default)", "rules": "firestore.rules" },
    { "database": "tilo-tokens", "rules": "firestore.tokens.rules" }
  ],
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "regex": ".*/\\..*", "destination": "/404.html" },
      { "source": "!/assets/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/ https://apis.google.com; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://content-firebaseappcheck.googleapis.com https://www.google.com/recaptcha/ https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://tilo-api-4qhkpsn5ga-as.a.run.app; frame-src https://www.google.com/recaptcha/ https://essential-wares-510320-f0.firebaseapp.com/__/auth/; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
          },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/share/**",
        "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }]
      },
      {
        "source": "/oauth/google/callback",
        "headers": [
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "no-store" }
        ]
      },
      {
        "source": "/oauth/google/callback/",
        "headers": [
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "Cache-Control", "value": "no-store" }
        ]
      }
    ]
  }
}
