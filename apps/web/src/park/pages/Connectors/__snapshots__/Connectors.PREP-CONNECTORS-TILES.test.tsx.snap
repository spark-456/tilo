exports[`PREP-CONNECTORS-TILES flag off pins existing fixture page exactly 1`] = `"<div data-park="" data-time="day"><div data-testid="park-page-connectors"><section class="park-sheet"><div class="park-connectors-top"><div class="park-connectors-titles"><div class="park-connectors-titlerow"><h1 class="park-connectors-h1">Connectors</h1><span class="park-connectors-count">6 connected</span></div><p class="park-connectors-sub">The tools your agents can use, and how far each one can go.</p></div><div class="park-connectors-search"><svg width="16" height="16" viewBox="-10 -10 20 20" style="display: block; flex-grow: 0; flex-shrink: 0; flex-basis: auto;" aria-hidden="true"><g transform="translate(0 0) scale(0.9)"><circle cx="-1.5" cy="-1.5" r="4.8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none"></circle><path d="M2.2 2.2 L6.5 6.5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></g></svg><input class="park-connectors-search-input" aria-label="Search connectors" placeholder="Search 60+ tools" value=""></div></div><div class="park-connectors-banner" role="status"><span class="park-connectors-banner-icon"><svg width="18" height="18" viewBox="-10 -10 20 20" style="display: block; flex-grow: 0; flex-shrink: 0; flex-basis: auto;" aria-hidden="true"><path d="M-3 -8 V-4 M3 -8 V-4 M0 4.5 V8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path><path d="M-6 -4 H6 V-0.5 Q6 4.5 0 4.5 Q-6 4.5 -6 -0.5 Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></svg></span><div class="park-connectors-banner-text"><div class="park-connectors-banner-title">HubSpot sign-in expires in 3 days</div><div class="park-connectors-banner-sub">Scan competitor prices reads contacts from it. Reconnect to keep it running.</div></div><button type="button" class="park-connectors-reconnect">Reconnect</button></div><section class="park-connectors-section" aria-label="Connected"><div class="park-connectors-sechead"><span class="park-connectors-sectitle">Connected</span><span class="park-connectors-count">6 connected</span></div><div class="park-connectors-grid"><button type="button" class="park-connectors-tile"><span class="park-connectors-tile-head"><span class="park-connectors-mono" style="color: #D2463A;">G</span><span class="park-connectors-tile-names"><span class="park-connectors-tile-name">Gmail</span><span class="park-connectors-tile-acct">alex@northwind.co</span></span><span class="park-connectors-level park-connectors-level--3">Act</span></span><span class="park-connectors-tile-foot"><span class="park-connectors-sync"><span class="park-connectors-dot"></span>Example only: not synced</span><span class="park-connectors-used">Used by 3</span></span></button><button type="button" class="park-connectors-tile"><span class="park-connectors-tile-head"><span class="park-connectors-mono" style="color: #2F6FD8;">C</span><span class="park-connectors-tile-names"><span class="park-connectors-tile-name">Google Calendar</span><span class="park-connectors-tile-acct">alex@northwind.co</span></span><span class="park-connectors-level park-connectors-level--3">Act</span></span><span class="park-connectors-tile-foot"><span class="park-connectors-sync"><span class="park-connectors-dot"></span>Example only: not synced</span><span class="park-connectors-used">Used by 2</span></span></button><button type="button" class="park-connectors-tile"><span class="park-connectors-tile-head"><span class="park-connectors-mono" style="color: #1C8F5E;">D</span><span class="park-connectors-tile-names"><span class="park-connectors-tile-name">Google Drive</span><span class="park-connectors-tile-acct">Northwind shared drive</span></span><span class="park-connectors-level park-connectors-level--1">Read</span></span><span class="park-connectors-tile-foot"><span class="park-connectors-sync"><span class="park-connectors-dot"></span>Example only: not synced</span><span class="park-connectors-used">Used by 2</span></span></button><button type="button" class="park-connectors-tile"><span class="park-connectors-tile-head"><span class="park-connectors-mono" style="color: #6B3A86;">S</span><span class="park-connectors-tile-names"><span class="park-connectors-tile-name">Slack</span><span class="park-connectors-tile-acct">northwind.slack.com</span></span><span class="park-connectors-level park-connectors-level--2">Draft</span></span><span class="park-connectors-tile-foot"><span class="park-connectors-sync"><span class="park-connectors-dot"></span>Example only: not synced</span><span class="park-connectors-used">Used by 2</span></span></button><button type="button" class="park-connectors-tile"><span class="park-connectors-tile-head"><span class="park-connectors-mono" style="color: #0E85B0;">X</span><span class="park-connectors-tile-names"><span class="park-connectors-tile-name">Xero</span><span class="park-connectors-tile-acct">Northwind Ltd</span></span><span class="park-connectors-level park-connectors-level--2">Draft</span></span><span class="park-connectors-tile-foot"><span class="park-connectors-sync"><span class="park-connectors-dot"></span>Example only: not synced</span><span class="park-connectors-used">Used by 2</span></span></button><button type="button" class="park-connectors-tile park-connectors-tile--attn"><span class="park-connectors-tile-head"><span class="park-connectors-mono" style="color: #D9622B;">H</span><span class="park-connectors-tile-names"><span class="park-connectors-tile-name">HubSpot</span><span class="park-connectors-tile-acct">Northwind sales</span></span><span class="park-connectors-level park-connectors-level--1">Read</span></span><span class="park-connectors-tile-foot"><span class="park-connectors-sync park-connectors-sync--attn"><span class="park-connectors-dot park-connectors-dot--attn"></span>Sign-in expires in 3 days</span><span class="park-connectors-used">Used by 1</span></span></button></div></section><section class="park-connectors-section" aria-label="Available"><div class="park-connectors-sechead"><span class="park-connectors-sectitle">Add a tool</span><span class="park-connectors-count">Sign in with the tool. Tilo never sees your password.</span></div><div class="park-connectors-availgrid"><div class="park-connectors-avail"><span class="park-connectors-avail-mono" style="color: var(--ink);">N</span><span class="park-connectors-avail-names"><span class="park-connectors-avail-name">Notion</span><span class="park-connectors-avail-blurb">Read and write team docs and wikis</span></span><button type="button" class="park-connectors-connect">Connect</button></div><div class="park-connectors-avail"><span class="park-connectors-avail-mono" style="color: #C9472A;">M</span><span class="park-connectors-avail-names"><span class="park-connectors-avail-name">Microsoft 365</span><span class="park-connectors-avail-blurb">Outlook mail, calendar, OneDrive</span></span><button type="button" class="park-connectors-connect">Connect</button></div><div class="park-connectors-avail"><span class="park-connectors-avail-mono" style="color: #2659C9;">J</span><span class="park-connectors-avail-names"><span class="park-connectors-avail-name">Jira</span><span class="park-connectors-avail-blurb">Create and update issues</span></span><button type="button" class="park-connectors-connect">Connect</button></div><div class="park-connectors-avail"><span class="park-connectors-avail-mono" style="color: var(--ink);">GH</span><span class="park-connectors-avail-names"><span class="park-connectors-avail-name">GitHub</span><span class="park-connectors-avail-blurb">Read repos, open issues and PRs</span></span><button type="button" class="park-connectors-connect">Connect</button></div><div class="park-connectors-avail"><span class="park-connectors-avail-mono" style="color: #5A4FD8;">S</span><span class="park-connectors-avail-names"><span class="park-connectors-avail-name">Stripe</span><span class="park-connectors-avail-blurb">Read payments and refunds</span></span><button type="button" class="park-connectors-connect">Connect</button></div><div class="park-connectors-avail"><span class="park-connectors-avail-mono" style="color: #5E9E2E;">B</span><span class="park-connectors-avail-names"><span class="park-connectors-avail-name">BambooHR</span><span class="park-connectors-avail-blurb">Read people records and time off</span></span><button type="button" class="park-connectors-connect">Connect</button></div></div></section><div><p>Sample recorded run · no live action is shown.</p><div class="park-card"><section aria-label="Run connections"><h2 class="park-team-h2">Run connections</h2><output>Loading connections…</output></section></div><div class="park-card"><section aria-label="Waiting for your consent"><h2 class="park-team-h2">Waiting for your consent</h2><ul></ul><p>No access request is waiting.</p></section></div></div></section></div></div>"`;

exports[`PREP-CONNECTORS-TILES flag off pins existing live page exactly 1`] = `"<div data-park="" data-time="day"><div data-testid="park-page-connectors"><section class="park-sheet"><div class="park-connectors-top"><div class="park-connectors-titles"><div class="park-connectors-titlerow"><h1 class="park-connectors-h1">Connectors</h1></div><p class="park-connectors-sub">The tools your agents can use, and how far each one can go.</p></div></div><section class="park-connectors-section" aria-label="Meeting host account"><div class="park-connectors-sechead"><span class="park-connectors-sectitle">Meeting host account</span><span class="park-connectors-count">Hosted meetings come from Tilo's own account.</span></div><output class="park-connectors-note">Signing in the meeting host needs a real Tilo sign-in. This demo or replay session cannot connect a Google account.</output></section><div class="park-connectors-search"><input class="park-connectors-search-input" aria-label="Search connectors" placeholder="Search tools" value=""></div><p class="park-connectors-note">Connecting, reconnecting and changing access are not available here yet.</p><p>No connectors available yet</p><section class="park-connectors-section" aria-label="Tools"><div class="park-connectors-grid"></div></section><details><summary>Manage team tool access</summary></details><div><p>Sample recorded run · no live action is shown.</p><div class="park-card"><section aria-label="Run connections"><h2 class="park-team-h2">Run connections</h2><output>Loading connections…</output></section></div><div class="park-card"><section aria-label="Waiting for your consent"><h2 class="park-team-h2">Waiting for your consent</h2><ul></ul><p>No access request is waiting.</p></section></div></div></section></div></div>"`;

