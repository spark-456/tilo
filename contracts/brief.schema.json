{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tilo.example/brief.schema.json",
  "x-version": "1.0.0",
  "title": "Brief",
  "description": "Structured brief the Director extracts from intake (PRD 7.1 FR-INT-03, FR-INT-04, FR-INT-05). Every field is an editable chip; empty arrays are allowed, missing keys are not.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "deliverables",
    "audience",
    "deadline",
    "constraints",
    "sources",
    "sensitivity",
    "assumptions",
    "applied_preferences"
  ],
  "properties": {
    "goal": { "type": "string", "minLength": 1, "maxLength": 500 },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/deliverable" }
    },
    "audience": { "type": "string", "minLength": 1, "maxLength": 200 },
    "deadline": {
      "description": "Due date, or null when the task has none.",
      "anyOf": [{ "$ref": "common.schema.json#/$defs/calendar_date" }, { "type": "null" }]
    },
    "constraints": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "sources": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/source" }
    },
    "sensitivity": {
      "description": "Most sensitive class of data the task touches (PRD 12.1 data classes; ADR-0002).",
      "$ref": "common.schema.json#/$defs/data_class"
    },
    "assumptions": {
      "description": "FR-INT-04: what was assumed instead of asking, shown as \"Assumed: ...\".",
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/assumption" }
    },
    "applied_preferences": {
      "description": "FR-INT-05: preferences and past answers applied from memory instead of asking, each with its citation.",
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/applied_preference" }
    }
  },
  "$defs": {
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "format"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "format": { "$ref": "common.schema.json#/$defs/deliverable_format" }
      }
    },
    "source": {
      "description": "Where material comes from. ref is an artifact id (file), a URL (url), a connector id (connector), a search query (web) or a memory entry id (memory).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "type": "string", "enum": ["file", "url", "connector", "web", "memory"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "assumed"],
      "properties": {
        "question": {
          "description": "The clarifying question that was skipped, or null when nothing was asked.",
          "type": ["string", "null"],
          "maxLength": 300
        },
        "assumed": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "applied_preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "citation"],
      "properties": {
        "field": {
          "description": "Brief field the preference filled.",
          "type": "string",
          "enum": [
            "goal",
            "deliverables",
            "audience",
            "deadline",
            "constraints",
            "sources",
            "sensitivity"
          ]
        },
        "value": { "type": "string", "minLength": 1, "maxLength": 300 },
        "citation": { "$ref": "#/$defs/citation" }
      }
    },
    "citation": {
      "description": "The stored preference or earlier decision that was applied (PRD 13.1 memory, 8.3 decisions).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "recorded_at"],
      "properties": {
        "kind": { "type": "string", "enum": ["preference", "decision"] },
        "ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "recorded_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    }
  }
}
