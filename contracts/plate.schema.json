{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tilo.example/plate.schema.json",
  "x-version": "1.0.0",
  "title": "Plate",
  "description": "A person's plate (FR-PA-02, ADR-0021): a read model tilo-api builds per request for the signed-in person only, never stored and never an event (PE-26). S-27, the digest and the panel read the same `rows`; `parked` holds the person's own snoozed, reassign-asked and recently done work items for S-27 only (PE-27). Groups and order are code (PE-28): `today` is the date in the person's time zone at `as_of`. A row is a reference with at most a title (PE-29). `truncated` says rows beyond the caps exist; `fingerprint` is the SHA-256 of `rows` as JSON with sorted keys and no whitespace (PE-30).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "user", "as_of", "today", "rows", "parked", "truncated", "fingerprint"],
  "properties": {
    "v": { "const": "1.0" },
    "user": { "$ref": "common.schema.json#/$defs/user_id" },
    "as_of": { "$ref": "common.schema.json#/$defs/timestamp" },
    "today": { "$ref": "common.schema.json#/$defs/calendar_date" },
    "rows": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/plate_row" },
      "contains": { "properties": { "group": { "enum": ["snoozed", "asked", "done"] } } },
      "minContains": 0,
      "maxContains": 0
    },
    "parked": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/plate_row" },
      "contains": {
        "not": {
          "properties": {
            "ref": { "properties": { "kind": { "const": "work_item" } } },
            "group": { "enum": ["snoozed", "asked", "done"] }
          }
        }
      },
      "minContains": 0,
      "maxContains": 0
    },
    "truncated": { "type": "boolean" },
    "fingerprint": { "type": "string", "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "plate_row": {
      "description": "One row: what it points at, why it is here, its group, and a title, due date, time and assigner at most; never a body, quote, address, link or transcript line (PE-29). `title` is null for mail (BQ-269). `evidence` is true for a work item from a meeting that cites an utterance, whose quote the person may ask for (PE-23). `actions` is a hint; tilo-api checks every action again at the write (PE-10).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "reason",
        "group",
        "title",
        "due",
        "at",
        "from",
        "flagged",
        "evidence",
        "actions"
      ],
      "properties": {
        "ref": { "$ref": "#/$defs/row_ref" },
        "reason": { "$ref": "#/$defs/reason" },
        "group": { "$ref": "#/$defs/group" },
        "title": { "anyOf": [{ "$ref": "#/$defs/title" }, { "type": "null" }] },
        "due": {
          "anyOf": [{ "$ref": "common.schema.json#/$defs/calendar_date" }, { "type": "null" }]
        },
        "at": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
        "from": { "anyOf": [{ "$ref": "common.schema.json#/$defs/user_id" }, { "type": "null" }] },
        "flagged": { "type": "boolean" },
        "evidence": { "type": "boolean" },
        "actions": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/action" }
        }
      },
      "if": { "properties": { "ref": { "properties": { "kind": { "const": "work_item" } } } } },
      "then": {
        "properties": {
          "reason": { "const": "work_item" },
          "group": { "not": { "const": "attention" } },
          "actions": { "items": { "enum": ["open", "done", "snooze", "not_mine", "put_back"] } }
        }
      },
      "else": {
        "properties": { "evidence": { "const": false } },
        "if": { "properties": { "ref": { "properties": { "kind": { "const": "mail" } } } } },
        "then": {
          "properties": {
            "reason": { "const": "mail_reply" },
            "group": { "const": "rest" },
            "title": { "type": "null" },
            "due": { "type": "null" },
            "actions": { "items": { "enum": ["open", "draft_reply"] } }
          }
        },
        "else": {
          "properties": { "actions": { "items": { "const": "open" } } },
          "if": { "properties": { "reason": { "enum": ["gate", "consent", "blocked"] } } },
          "then": { "properties": { "group": { "const": "attention" } } },
          "else": { "properties": { "group": { "not": { "const": "attention" } } } }
        }
      }
    },
    "row_ref": {
      "description": "A common `record_ref` narrowed to the six plate sources (PE-27): a run row points at its world, a mail row at the triage message id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["work_item", "card", "world", "mail", "pinboard_item", "calendar_entry"]
        },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$" }
      }
    },
    "reason": {
      "description": "Why the row is here (PE-27): a gate, consent, blocked, question or meeting card; a blocked or running run (`blocked`, `run`); the person's work item; mail that needs a reply; a pin they own or are tagged on; today's calendar entry.",
      "type": "string",
      "enum": [
        "gate",
        "consent",
        "blocked",
        "question",
        "meeting_card",
        "run",
        "work_item",
        "mail_reply",
        "pin_owner",
        "pin_tagged",
        "calendar"
      ]
    },
    "group": {
      "description": "`attention`, `overdue`, `soon` and `rest` order `rows` (PE-28); `snoozed`, `asked` and `done` are the `parked` lanes, work items only.",
      "type": "string",
      "enum": ["attention", "overdue", "soon", "rest", "snoozed", "asked", "done"]
    },
    "title": {
      "description": "The record's own title, cut to 140 characters: one line, untrusted, shown as plain text.",
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
      "not": { "pattern": "[\\n\\r]" }
    },
    "action": {
      "type": "string",
      "enum": ["open", "done", "snooze", "not_mine", "put_back", "draft_reply"]
    }
  }
}
