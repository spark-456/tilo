{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tilo.example/events/data/approval.requested.schema.json",
  "x-version": "1.0.0",
  "title": "ApprovalRequestedData",
  "description": "data of approval.requested (PRD 9.5). A proposed side effect waits at a gate for a person. outbox_id is reserved for the outbox entry the gate releases (card rule CR-12); nothing is written to the outbox before the gate opens.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate_id", "card_id", "outbox_id", "action_type", "risk_tier", "irreversible"],
  "properties": {
    "gate_id": { "$ref": "../../common.schema.json#/$defs/gate_id" },
    "card_id": { "$ref": "../../common.schema.json#/$defs/ulid" },
    "outbox_id": { "$ref": "../../common.schema.json#/$defs/ulid" },
    "action_type": { "$ref": "../../common.schema.json#/$defs/action_type" },
    "risk_tier": { "$ref": "../../common.schema.json#/$defs/risk_tier" },
    "irreversible": { "type": "boolean" }
  }
}
