{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tilo.example/events/data/connection.consented.schema.json",
  "x-version": "1.0.0",
  "title": "ConnectionConsentedData",
  "description": "data of connection.consented (PRD 9.5). A person granted a connection on the web (consent option connect, CR-13); a grant is an authorisation, so the event carries authz.",
  "type": "object",
  "additionalProperties": false,
  "required": ["connector", "card_id", "scopes"],
  "properties": {
    "connector": { "$ref": "../../common.schema.json#/$defs/connector_id" },
    "card_id": { "$ref": "../../common.schema.json#/$defs/ulid" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
