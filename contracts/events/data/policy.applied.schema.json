{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tilo.example/events/data/policy.applied.schema.json",
  "x-version": "1.0.0",
  "title": "PolicyAppliedData",
  "description": "data of policy.applied (PRD 9.5). The deterministic policy engine opened a gate under a policy (PRD 10.4). Never T3, never below L2. authz is by policy with ref equal to policy_id (EV-06), so the world draws a policy stamp and links it (HR-7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "gate_id",
    "outbox_id",
    "action_type",
    "risk_tier",
    "level",
    "undo_window_s"
  ],
  "properties": {
    "policy_id": { "$ref": "../../common.schema.json#/$defs/policy_id" },
    "gate_id": { "$ref": "../../common.schema.json#/$defs/gate_id" },
    "outbox_id": { "$ref": "../../common.schema.json#/$defs/ulid" },
    "action_type": { "$ref": "../../common.schema.json#/$defs/action_type" },
    "risk_tier": { "type": "string", "enum": ["T1", "T2"] },
    "level": { "type": "string", "enum": ["L2", "L3"] },
    "undo_window_s": { "type": "integer", "minimum": 0 }
  }
}
