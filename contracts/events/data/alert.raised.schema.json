{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tilo.example/events/data/alert.raised.schema.json",
  "x-version": "1.0.0",
  "title": "AlertRaisedData",
  "description": "data of alert.raised (PRD 9.5). The event severity picks the rung; card_id is set when a card asks the person something.",
  "type": "object",
  "additionalProperties": false,
  "required": ["alert_id", "card_id"],
  "properties": {
    "alert_id": { "$ref": "../../common.schema.json#/$defs/ulid" },
    "card_id": {
      "anyOf": [{ "$ref": "../../common.schema.json#/$defs/ulid" }, { "type": "null" }]
    }
  }
}
