{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tilo.example/work_item.schema.json",
  "x-version": "1.0.0",
  "title": "WorkItem",
  "description": "One thing a person has to do (FR-PA-01): from confirmed minutes, from mail the person marked, or by hand. Visible to its `owner`; the person who assigned it sees its status only, and only once it is no longer `proposed` (PE-03). An item Tilo made starts `proposed` and leaves that state only with `confirmed_by`, the meeting Owner (PE-07). A model never sets `due`: code computes it from `due_text` (PE-15).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "org_id",
    "owner",
    "title",
    "due",
    "due_text",
    "status",
    "source",
    "created_by",
    "assigned_by",
    "confirmed_by",
    "snoozed_until",
    "history",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/work_item_id"
    },
    "org_id": {
      "$ref": "common.schema.json#/$defs/org_id"
    },
    "owner": {
      "$ref": "common.schema.json#/$defs/user_id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
      "not": {
        "pattern": "[\\n\\r]"
      }
    },
    "due": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/calendar_date"
        },
        {
          "type": "null"
        }
      ]
    },
    "due_text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "not": {
            "pattern": "[\\n\\r]"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "open", "done", "dropped"]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/maker"
    },
    "assigned_by": {
      "anyOf": [
        {
          "$ref": "team_lead.schema.json#/$defs/assignment"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_by": {
      "anyOf": [
        {
          "$ref": "team_lead.schema.json#/$defs/assignment"
        },
        {
          "type": "null"
        }
      ]
    },
    "snoozed_until": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/history_entry"
      }
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "if": {
    "properties": {
      "created_by": {
        "properties": {
          "by": {
            "const": "tilo"
          }
        },
        "required": ["by"]
      },
      "status": {
        "enum": ["open", "done"]
      }
    },
    "required": ["created_by", "status"]
  },
  "then": {
    "properties": {
      "confirmed_by": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "source": {
      "description": "Where the item came from; evidence lists the utterances of a meeting transcript.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "evidence"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["meeting", "mail", "manual", "pinboard", "request"]
        },
        "ref": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/opaque_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/utterance_id"
          }
        }
      }
    },
    "history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "by", "change", "status"],
      "properties": {
        "at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "by": {
          "$ref": "event.schema.json#/$defs/actor"
        },
        "change": {
          "type": "string",
          "enum": [
            "created",
            "confirmed",
            "edited",
            "snoozed",
            "done",
            "dropped",
            "reopened",
            "reassign_requested",
            "reminded"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["proposed", "open", "done", "dropped"]
        }
      }
    }
  }
}
