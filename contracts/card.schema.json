{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tilo.example/card.schema.json",
  "x-version": "1.0.0",
  "title": "Card",
  "description": "One card, every channel (PRD 10.2, 10.3): needs-you, gate, consent and meeting cards. Channel rules are data: answer_channels is limited per kind (email answers questions only; gates need sign-in on the web or a verified WhatsApp number; consent needs the web). safe_default is the option id applied at timeout; it names one of the options and that option is reversible (contracts/card.rules.md CR-01 to CR-03). A gate's is always hold, so a gate never times out to go, and only a gate may offer an irreversible option.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "world_id",
    "run_id",
    "kind",
    "rung",
    "header",
    "what_happened",
    "why_it_matters",
    "options",
    "add_context",
    "actions",
    "answer_channels",
    "created_at",
    "timeout",
    "safe_default",
    "gate",
    "consent"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/ulid" },
    "world_id": { "$ref": "common.schema.json#/$defs/world_id" },
    "run_id": { "$ref": "common.schema.json#/$defs/run_id" },
    "kind": { "type": "string", "enum": ["needs_you", "gate", "consent", "meeting"] },
    "rung": {
      "description": "Escalation ladder rung (PRD 10.2); needs_you cards may be blocked.",
      "type": "string",
      "enum": ["needs_you", "blocked", "meeting", "gate", "consent"]
    },
    "header": { "$ref": "#/$defs/header" },
    "what_happened": { "type": "string", "minLength": 1, "maxLength": 140 },
    "why_it_matters": { "type": "string", "minLength": 1, "maxLength": 280 },
    "options": { "$ref": "#/$defs/options" },
    "add_context": {
      "description": "Whether the card offers the add-context field.",
      "type": "boolean"
    },
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["show_me", "snooze", "delegate"] }
    },
    "answer_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/channel" }
    },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "timeout": {
      "description": "Seconds after created_at when the safe default applies and the Director posts a Nudge.",
      "type": "integer",
      "minimum": 1
    },
    "safe_default": { "$ref": "#/$defs/option_id" },
    "gate": {
      "description": "Set on gate cards only.",
      "anyOf": [{ "$ref": "#/$defs/gate" }, { "type": "null" }]
    },
    "consent": {
      "description": "Set on consent cards only.",
      "anyOf": [{ "$ref": "#/$defs/consent" }, { "type": "null" }]
    }
  },
  "if": { "properties": { "kind": { "const": "gate" } }, "required": ["kind"] },
  "then": {
    "description": "A gate offers a reversible hold, holds by default, is never delegated to the Director and is never answered by email.",
    "properties": {
      "rung": { "const": "gate" },
      "options": {
        "contains": {
          "properties": { "id": { "const": "hold" }, "irreversible": { "const": false } },
          "required": ["id", "irreversible"]
        }
      },
      "safe_default": { "const": "hold" },
      "actions": { "items": { "enum": ["show_me", "snooze"] } },
      "answer_channels": { "items": { "enum": ["web", "mobile_web", "whatsapp"] } },
      "gate": { "type": "object" },
      "consent": { "type": "null" }
    }
  },
  "else": {
    "description": "Only a gate may offer an irreversible option (every irreversible action maps to a gate, plan.rules.md PG-04), so a non-gate card never times out to one.",
    "properties": {
      "gate": { "type": "null" },
      "options": { "items": { "properties": { "irreversible": { "const": false } } } }
    },
    "if": { "properties": { "kind": { "const": "consent" } }, "required": ["kind"] },
    "then": {
      "properties": {
        "rung": { "const": "consent" },
        "answer_channels": { "items": { "enum": ["web", "mobile_web"] } },
        "consent": { "type": "object" }
      }
    },
    "else": {
      "properties": { "consent": { "type": "null" } },
      "if": { "properties": { "kind": { "const": "meeting" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "rung": { "const": "meeting" },
          "answer_channels": { "items": { "enum": ["web", "mobile_web", "whatsapp"] } }
        }
      },
      "else": { "properties": { "rung": { "enum": ["needs_you", "blocked"] } } }
    }
  },
  "$defs": {
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building", "agent"],
      "properties": {
        "building": { "$ref": "common.schema.json#/$defs/building_id" },
        "agent": { "$ref": "common.schema.json#/$defs/agent_id" }
      }
    },
    "option_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "options": {
      "description": "2-3 options, exactly one suggested.",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/option" },
      "contains": { "properties": { "suggested": { "const": true } }, "required": ["suggested"] },
      "minContains": 1,
      "maxContains": 1
    },
    "option": {
      "description": "The suggested option carries a reason and is never irreversible.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "suggested", "irreversible"],
      "properties": {
        "id": { "$ref": "#/$defs/option_id" },
        "label": {
          "description": "At most 20 characters so it fits a WhatsApp reply button.",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "suggested": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 200 },
        "irreversible": { "type": "boolean" }
      },
      "if": { "properties": { "suggested": { "const": true } }, "required": ["suggested"] },
      "then": { "required": ["reason"], "properties": { "irreversible": { "const": false } } }
    },
    "gate": {
      "description": "The exact action a gate card holds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "recipients", "irreversible", "risk_tier"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/gate_id" },
        "action": { "$ref": "#/$defs/gate_action" },
        "recipients": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/email_address" }
        },
        "irreversible": { "type": "boolean" },
        "risk_tier": { "$ref": "common.schema.json#/$defs/risk_tier" }
      }
    },
    "gate_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "connector", "exact", "item"],
      "properties": {
        "type": { "$ref": "common.schema.json#/$defs/action_type" },
        "connector": { "$ref": "common.schema.json#/$defs/connector_id" },
        "exact": {
          "description": "Plain words for exactly what will happen.",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "item": {
          "description": "The draft or file that will be sent or shared, if any.",
          "anyOf": [{ "$ref": "common.schema.json#/$defs/artifact_ref" }, { "type": "null" }]
        }
      }
    },
    "consent": {
      "description": "The connection a consent card asks for.",
      "type": "object",
      "additionalProperties": false,
      "required": ["connector", "scopes"],
      "properties": {
        "connector": { "$ref": "common.schema.json#/$defs/connector_id" },
        "scopes": {
          "description": "Scopes requested, as listed in plain words on the consent sheet.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    }
  }
}
